{
  "schema_version": 1,
  "mode": "brokered_fetch",
  "default_action": "deny",
  "block_non_global_ips": true,
  "allowed_destinations": [
    {
      "name": "approved-update-server",
      "match": {
        "hosts": ["updates.example.org"],
        "ips": []
      },
      "schemes": ["http", "https"],
      "ports": [80, 443],
      "methods": ["GET", "HEAD"],
      "max_connections": 2,
