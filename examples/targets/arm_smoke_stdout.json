{
  "schema_version": 1,
  "goal_id": "arm_qemu_smoke_stdout",
  "description": "ARM static smoke payload executed through QEMU and printed arm-ok",
  "mode": "all",
  "rules": [
    {
      "id": "stdout_arm_ok",
      "type": "text_contains",
      "source": "stdout",
      "needle": "arm-ok",
      "min_count": 1
    },
    {
      "id": "guest_write_syscall",
      "type": "event_count",
      "source": "syscall",
      "where": {
        "syscall": "write",
        "execution_context": "guest",
        "trace_backend": "qemu_strace",
        "target_arch": "arm"
      },
      "min_count": 1
    }
  ]
}
